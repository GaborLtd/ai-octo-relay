{
  "command_prefix": "!",
  "default_agent": "codex",
  "store_path": "data/state.json",
  "state_store": {
    "type": "json",
    "path": "data/state.json"
  },
  "event_store": {
    "type": "jsonl",
    "path": "data/events.jsonl"
  },
  "log_level": "info",
  "quiet_by_default": true,
  "dm_read_only": true,
  "channel_write_prompt": "\nChannel/project mode is writable.\n\nRules:\n- If the user asks to create, update, rename, or delete files in the current project, perform the file changes directly in the workspace when the task is feasible.\n- Prefer making the actual project change over only drafting content in chat.\n- After changing files, summarize what changed and mention the main file paths.\n- If a requested change is risky or unclear, say what blocks it before making destructive edits.\n",
  "slack": {
    "app_token": "",
    "bot_token": ""
  },
  "projects": [
    {
      "name": "your-project",
      "path": "/path/to/your-project",
      "default_agent": "codex",
      "channel_ids": [],
      "commands": [
        {
          "name": "dev",
          "description": "start local dev server",
          "command": "make",
          "args": ["dev"]
        },
        {
          "name": "test",
          "description": "run project tests",
          "command": "make",
          "args": ["test"]
        }
      ]
    }
  ],
  "agents": {
    "codex": {
      "adapter": "codex",
      "aliases": ["o3", "openai"],
      "model": "gpt-5.2-codex",
      "command": "codex",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--color",
        "never",
        "--output-last-message",
        "{{last_message_path}}",
        "-C",
        "{{project_path}}",
        "-"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "claude": {
      "adapter": "claude",
      "aliases": ["sonnet"],
      "model": "claude-sonnet-4-5",
      "command": "claude",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "-p",
        "--output-format",
        "text",
        "--session-id",
        "{{native_session_id}}",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "gemini": {
      "adapter": "gemini",
      "aliases": ["flash"],
      "model": "gemini-2.5-flash",
      "command": "gemini",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "--output-format",
        "json",
        "-p",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    }
  }
}
