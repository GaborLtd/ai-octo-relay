{
  "command_prefix": "!",
  "default_agent": "codex",
  "language": "zh-TW",
  "store_path": "data/state.json",
  "state_store": {
    "type": "json",
    "path": "data/state.json"
  },
  "event_store": {
    "type": "jsonl",
    "path": "data/events.jsonl"
  },
  "log_level": "info",
  "quiet_by_default": true,
  "dm_read_only": true,
  "channel_write_prompt": "\n目前是 channel/project 可寫模式。\n\n規則：\n- 如果使用者要求建立、更新、重新命名或刪除目前專案內的檔案，且需求明確可行，請直接在 workspace 中完成修改。\n- 優先直接做出實際變更，不要只在對話中提供草稿。\n- 變更完成後，請用繁體中文簡短摘要，並列出主要檔案路徑。\n- 若需求有風險或不夠明確，先說明阻塞點，再避免做破壞性修改。\n",
  "prompts": {
    "default": {
      "channel_write": "\n目前是 channel/project 可寫模式。\n\n規則：\n- 如果使用者要求建立、更新、重新命名或刪除目前專案內的檔案，且需求明確可行，請直接在 workspace 中完成修改。\n- 優先直接做出實際變更，不要只在對話中提供草稿。\n- 變更完成後，請用繁體中文簡短摘要，並列出主要檔案路徑。\n- 若需求有風險或不夠明確，先說明阻塞點，再避免做破壞性修改。\n",
      "dm_read_only": "\n目前是 DM 唯讀模式。\n\n規則：\n- 只回答問題、解釋程式碼、做 code review，或提供文字版 patch 建議。\n- 不要修改檔案。\n- 不要執行會寫檔、變更 git 狀態、安裝套件或修改系統的命令。\n- 不要聲稱你已經改動專案。\n- 若使用者要求變更，請改提供分析、計畫或文字 diff。\n"
    },
    "agents": {
      "gemini": {
        "channel_write": "\n目前是 channel/project 可寫模式。\n\n規則：\n- 優先直接更新 workspace，不要只在對話中提供草稿。\n- 當使用者要求修改文件或程式碼時，只要需求明確可行，就直接建立或更新檔案。\n- 完成後請以繁體中文簡短摘要，並列出主要檔案路徑。\n- 不要使用英文回覆，除非使用者明確要求。\n",
        "dm_read_only": "\n目前是 DM 唯讀模式。\n\n規則：\n- 保持在規劃與分析模式。\n- 不要修改檔案。\n- 若使用者要求變更，請提供精簡的繁體中文計畫或草稿。\n"
      }
    }
  },
  "slack": {
    "app_token": "",
    "bot_token": ""
  },
  "projects": [
    {
      "name": "your-project",
      "path": "/path/to/your-project",
      "default_agent": "codex",
      "channel_ids": [],
      "commands": [
        {
          "name": "dev",
          "description": "start local dev server",
          "command": "make",
          "args": ["dev"]
        },
        {
          "name": "test",
          "description": "run project tests",
          "command": "make",
          "args": ["test"]
        }
      ]
    }
  ],
  "agents": {
    "codex": {
      "adapter": "codex",
      "aliases": ["o3", "openai"],
      "prompt_engineering": false,
      "model": "gpt-5.2-codex",
      "command": "codex",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--color",
        "never",
        "--output-last-message",
        "{{last_message_path}}",
        "-C",
        "{{project_path}}",
        "-"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "claude": {
      "adapter": "claude",
      "aliases": ["sonnet"],
      "prompt_engineering": false,
      "model": "claude-sonnet-4-5",
      "command": "claude",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "-p",
        "--output-format",
        "text",
        "--session-id",
        "{{native_session_id}}",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "gemini": {
      "adapter": "gemini",
      "aliases": ["flash"],
      "prompt_engineering": true,
      "model": "gemini-2.5-flash",
      "command": "gemini",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "--output-format",
        "stream-json",
        "-p",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    }
  }
}
