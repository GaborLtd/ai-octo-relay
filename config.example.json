{
  "command_prefix": "!",
  "default_agent": "codex",
  "store_path": "data/state.json",
  "log_level": "info",
  "quiet_by_default": true,
  "slack": {
    "app_token": "",
    "bot_token": ""
  },
  "projects": [
    {
      "name": "your-project",
      "path": "/path/to/your-project",
      "default_agent": "codex",
      "channel_ids": []
    }
  ],
  "agents": {
    "codex": {
      "adapter": "codex",
      "command": "codex",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--color",
        "never",
        "--output-last-message",
        "{{last_message_path}}",
        "-C",
        "{{project_path}}",
        "-"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "claude": {
      "adapter": "claude",
      "command": "claude",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "-p",
        "--output-format",
        "text",
        "--session-id",
        "{{native_session_id}}",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    },
    "gemini": {
      "adapter": "gemini",
      "command": "gemini",
      "mode": "oneshot",
      "transport": "stdio",
      "args": [
        "--output-format",
        "json",
        "-p",
        "{{prompt}}"
      ],
      "env": {},
      "timeout_seconds": 1800,
      "response_idle_ms": 1800,
      "first_chunk_timeout_ms": 30000,
      "session_idle_ms": 900000,
      "startup_wait_ms": 1500
    }
  }
}
